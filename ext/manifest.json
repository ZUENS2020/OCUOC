{
  "manifest_version": 3,
  "name": "OCUOC Browser Bridge",
  "version": "0.1.0",
  "description": "Local browser-use bridge for the OCUOC MCP server. Study project, clean-room implementation. No sidebar, no account.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OCUOC bridge: 点击检查连接"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
